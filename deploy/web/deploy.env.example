# Copy these names into your shell environment. Never put real values in Git.
MC_DEPLOY_HOST=server.example.com
MC_DEPLOY_USER=root
MC_WEB_DOMAIN=feedback.example.com
MC_DESKTOP_HELPER=/absolute/path/to/mc-feedback-viewer.exe

MC_WEB_ADMIN_EMAIL=admin@example.com
MC_WEB_ADMIN_PASSWORD=
MC_WEB_MODEL_BASE_URL=https://api.example.com
MC_WEB_MODEL=your-model-name
MC_WEB_MODEL_API_KEY=

# Optional when migrating an existing single-user installation.
MC_WEB_LEGACY_NETEASE_ACCOUNT=
